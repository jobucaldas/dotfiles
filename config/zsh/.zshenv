# Repo owns this file. NixOS system profile supplies these dependencies.
export ZSH=/run/current-system/sw/share/oh-my-zsh
export ZSH_AUTOSUGGESTIONS=/run/current-system/sw/share/zsh/plugins/zsh-autosuggestions/zsh-autosuggestions.zsh
export ZSH_SYNTAX_HIGHLIGHTING=/run/current-system/sw/share/zsh-syntax-highlighting/zsh-syntax-highlighting.zsh
export ZSH_CACHE_DIR="${XDG_CACHE_HOME:-$HOME/.cache}/oh-my-zsh"
